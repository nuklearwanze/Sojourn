// FA-08 crew scenario: a two-person Mars expedition. Occupy a shielded transit
// craft, seat a commander and a pilot, maintain the ECLSS, ride out a solar storm
// in the shelter, resupply mid-cruise, switch the environment to Mars on arrival
// and attempt the (hard) EDL. Exercises the daily seeded step — dose accrual, SPE
// storms, deconditioning, psych load, ECLSS degradation/failure and the EDL roll —
// plus interrupt acknowledgement, for the double-run determinism + save/load gates.
(
    name: "crew-mission",
    seed: 7,
    horizon_years: 100,
    run_mode: SaveAnywhere,
    synthetic: None,
    crew: true,
    commands: [
        (tick: 0, crew: Some(OccupyAsset(
            faction: 0,
            asset: 0,
            sizing: (
                closure_capability: 0.9,
                shield_attenuation: 0.3,
                population_capacity: 6,
                spin_gravity: false,
                habitat_volume_m3_per_crew: 40.0,
                consumables_capacity_kg: 300000.0,
                crewed: true,
            ),
            env: (
                gcr_rate_sv_yr: 0.66,
                body: "mars-transit",
                comms_lag_s: 600.0,
                abort_reach: false,
            ),
            eclss_maturity: (trl: 8, reliability: 0.95, flight_units: 4),
            ops_oversub: 0.2,
            consumables_kg: 250000.0,
        ))),
        (tick: 0, crew: Some(AssignCrew(
            asset: 0,
            astronaut: "cmdr",
            facts: (age_years: 45.0, sex: Male, traits: [], training: 0.9),
        ))),
        (tick: 0, crew: Some(AssignCrew(
            asset: 0,
            astronaut: "pilot",
            facts: (age_years: 38.0, sex: Female, traits: [], training: 0.85),
        ))),
        // Day 30: scheduled ECLSS maintenance.
        (tick: 2592000, crew: Some(Maintain(asset: 0, crew_hr: 200.0, spares_kg: 50.0))),
        // Days 60-61: a solar-particle event — take shelter, then stand down.
        (tick: 5184000, crew: Some(Shelter(asset: 0, sheltering: true))),
        (tick: 5270400, crew: Some(Shelter(asset: 0, sheltering: false))),
        // Day 90: maintenance + a resupply top-up.
        (tick: 7776000, crew: Some(Maintain(asset: 0, crew_hr: 200.0, spares_kg: 50.0))),
        (tick: 7776000, crew: Some(Resupply(asset: 0, kg: 5000.0))),
        // Day 150: arrival — the environment becomes Mars (abort now in reach).
        (tick: 12960000, crew: Some(UpdateEnv(
            asset: 0,
            env: (gcr_rate_sv_yr: 0.23, body: "mars", comms_lag_s: 900.0, abort_reach: true),
            ops_oversub: 0.1,
        ))),
        // Day 180: attempt the entry/descent/landing with a heat-shielded lander.
        (tick: 15552000, crew: Some(EvaluateEdl(
            asset: 0,
            suitability: (can_land: true, has_heat_shield: true, landing_tw: 1.4),
        ))),
    ],
    checkpoints: [86400, 7776000, 17280000],
    until_tick: 17280000,
)

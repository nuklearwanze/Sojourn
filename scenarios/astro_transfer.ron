// Astro transfer scenario (T031): plan and fly a LEO→GEO Hohmann with committed
// nodes — maneuver-node pauses, finite burns, rocket-equation propellant.
Scenario(
    name: "astro_transfer",
    seed: 271,
    horizon_years: 100,
    run_mode: SaveAnywhere,
    synthetic: None,
    toy: false,
    astro: true,
    commands: [
        (tick: 0, astro: Some(SpawnCraft(
            name_id: "geo-bird",
            dominant: 1,
            state: (r: (x: 6.678e6, y: 0.0, z: 0.0), v: (x: 0.0, y: 7725.84, z: 0.0)),
            dry_mass: 500.0,
            propellant: 1500.0,
            engine: "chem-hydrolox",
            available_power_w: 0.0,
            drag_area_m2: 0.0,
            srp_area_m2: 0.0,
        ))),
        (tick: 60, astro: Some(CreateNode(craft: 0, epoch_tick: 600, dv_prn: (x: 2425.8, y: 0.0, z: 0.0)))),
        (tick: 60, astro: Some(CreateNode(craft: 0, epoch_tick: 19591, dv_prn: (x: 1466.9, y: 0.0, z: 0.0)))),
        (tick: 120, astro: Some(CommitPlan(craft: 0, nodes: [0, 1], aim: None))),
    ],
    checkpoints: [
        20000,
        25000,
    ],
    until_tick: 25000,
)

// Statistical prospecting fields (FR-WORLD-501): sourced population models for the
// uncatalogued belt/NEA populations. Prospecting draws new small bodies from these.
(
    fields: [
        (
            id: "main-belt",
            count_per_effort: 3.0,
            sma_au: (lo: 2.1, hi: 3.3),
            ecc: (lo: 0.0, hi: 0.30),
            inc_deg: (lo: 0.0, hi: 20.0),
            diameter_m: (lo: 200.0, hi: 5000.0),
            density_kg_m3: 2000.0,
            type_mix: [("C", 0.75), ("S", 0.17), ("M", 0.08)],
            source: "Main-belt size-frequency and taxonomic mix (SDSS/WISE debiased; C-complex dominant outward)",
        ),
        (
            id: "nea",
            count_per_effort: 1.2,
            sma_au: (lo: 0.8, hi: 2.5),
            ecc: (lo: 0.1, hi: 0.6),
            inc_deg: (lo: 0.0, hi: 30.0),
            diameter_m: (lo: 30.0, hi: 1000.0),
            density_kg_m3: 2200.0,
            type_mix: [("S", 0.50), ("C", 0.35), ("X", 0.15)],
            source: "Near-Earth asteroid population model (NEOWISE/Granvik debiased SFD and orbital distribution)",
        ),
    ],
)

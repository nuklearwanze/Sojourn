// Astrodynamics config for the real-world data dir (same sourced engineering values as
// data/astro/config.ron; the harness loads the propagator from data/world for FA-03).
(
    coast_step_s: 60,
    encounter_step_s: 1,
    burn_substep_s: 0.25,
    lowthrust_accel_threshold: 0.01,
    encounter_radius_factor: 20.0,
    divergence_threshold_m: 5.0e7,
    reconcile_interval_ticks: 86400,
    diversion_budget: 16,
    exec_error: (
        sigma_mag: 0.005,
        sigma_point_rad: 0.005,
        enabled: false,
        source: "Typical chemical-stage execution dispersions <1% magnitude, ~0.3 deg pointing (JPL navigation practice)",
    ),
    lambert_max_iter: 60,
    lambert_tol: 1.0e-8,
    drag_cd: 2.2,
    srp_cr: 1.3,
    solar_flux_w_m2: 1361.0,
    flux_reference_m: 1.495978707e11,
    light_speed_m_s: 299792458.0,
    aero_min_periapsis_alt_m: 50000.0,
    source: "Cd=2.2 (Vallado); Cr=1.3 (Montenbruck & Gill); solar constant 1361 W/m2 (SORCE/TIM); c (SI defined); step tiers engineering defaults",
)

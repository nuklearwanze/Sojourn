// Astrodynamics module configuration (research R2/R7/R10/R12). Engineering values, never
// code constants (Principle V). SI units; sources on plausibility-bearing entries.
(
    // Step tiers (research R2) — state-driven, warp-invariant.
    coast_step_s: 60,
    encounter_step_s: 1,
    burn_substep_s: 0.25,
    // Acceleration below this is "low-thrust": integrated at coast tier with thrust applied.
    lowthrust_accel_threshold: 0.01,
    // Encounter tier engages within this multiple of the dominant body's radius.
    encounter_radius_factor: 20.0,

    // Reconciliation (FR-ASTRO-402).
    divergence_threshold_m: 5.0e7,
    reconcile_interval_ticks: 86400,

    // Divertible small bodies (FR-ASTRO-107).
    diversion_budget: 16,

    // Execution error (FR-ASTRO-304).
    exec_error: (
        sigma_mag: 0.005,
        sigma_point_rad: 0.005,
        enabled: false,
        source: "Typical chemical-stage execution dispersions <1% magnitude, ~0.3 deg pointing (JPL navigation practice, e.g. Mars mission TCM budgets)",
    ),

    // Lambert solver caps (research R4).
    lambert_max_iter: 60,
    lambert_tol: 1.0e-8,

    // Force-model constants.
    drag_cd: 2.2,
    srp_cr: 1.3,
    solar_flux_w_m2: 1361.0,
    flux_reference_m: 1.495978707e11,
    light_speed_m_s: 299792458.0,

    // Aerocapture limits (FR-ASTRO-407): periapsis floor for the depth/load limit.
    aero_min_periapsis_alt_m: 50000.0,

    source: "Cd=2.2 (standard flat-plate satellite drag coefficient, Vallado); Cr=1.3 (typical SRP reflectivity coefficient, Montenbruck & Gill); solar constant 1361 W/m2 (SORCE/TIM); c (SI defined); step tiers and thresholds are engineering defaults, not plausibility-bearing",
)

// FA-08 radiation params (FR-LSC-201…205, Q2). GCR rate per environment, seeded
// SPE storms, storm-shelter attenuation, and the dose->REID curve (age/sex).
(
    gcr_by_env: {
        "default": 0.6,
        "mars-transit": 0.66,
        "mars": 0.23,
        "moon": 0.38,
        "leo": 0.1,
    },
    spe_daily_prob: 0.002,
    spe_magnitude_sv: 0.5,
    shelter_attenuation: 0.1,
    reid: (
        pct_per_sv: 5.0,
        age_coeff: 0.01,
        age_baseline: 40.0,
        sex_mult_female: 1.3,
        threshold_pct: 3.0,
        source: "NASA/NCRP REID model: ~3-5% REID per Sv, age/sex-adjusted, 3% career limit (design/04-SPACEFLIGHT.md §6)",
    ),
    source: "deep-space GCR ~0.5-0.66 Sv/yr; SPE acute dose & storm-shelter studies (design/04-SPACEFLIGHT.md §6, F7)",
)
